# ==============================
# MediClear .gitignore
# ==============================

# Environment variables / secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local
frontend/.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Virtual environment
venv/
.venv/
backend/venv/
backend/.venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Medical reports / user data
*.pdf
*.jpg
*.jpeg
*.png

# Local sample data
data/samples/*
!data/samples/.gitkeep

# Logs
*.log