# MediClear backend configuration
# Copy this file to backend/.env and fill in the values.
# backend/.env is git-ignored — never commit it.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: lets the backend write past Row Level Security and roll
# back failed registrations. Without it the backend falls back to the anon key.
# Backend only — never put this in the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key

# ── AI explanations (optional) ───────────────────────────────────────────────
# Without AI_API_KEY, explanations use a basic built-in fallback text.
# Any OpenAI-compatible provider works. Defaults: OpenAI, gpt-3.5-turbo.
AI_API_KEY=your-ai-api-key
# For Groq instead of OpenAI (Groq keys start with "gsk_"). Set BOTH lines,
# otherwise the key is sent to OpenAI and every explanation fails:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b

# ── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend settings live in frontend/.env.local — see frontend/.env.local.example
